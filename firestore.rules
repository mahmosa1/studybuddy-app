rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function isProtectedPath() {
      return request.path.matches('/databases/.*/documents/courseJoinRequests/.*') ||
        request.path.matches('/databases/.*/documents/courses/.*') ||
        request.path.matches('/databases/.*/documents/tutorExercises/.*') ||
        request.path.matches('/databases/.*/documents/tutorExerciseSubmissions/.*');
    }
    
    // Users collection - CRITICAL for login flow
    match /users/{userId} {
      // Allow authenticated users to read ANY user document (needed for login check)
      allow read: if isAuthenticated();
      
      // Users can create their own document during registration
      allow create: if isAuthenticated() && 
        (request.resource.data.uid == request.auth.uid || 
         request.resource.data.uid == userId);
      
      // Users can update their own document
      allow update: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow delete for authenticated users (admin checks in app)
      allow delete: if isAuthenticated();
    }
    
    // Courses collection
    match /courses/{courseId} {
      // Anyone authenticated can read courses
      allow read: if isAuthenticated();
      
      // Users can create courses
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      
      // Only course owner/lecturer can update/delete
      allow update, delete: if isAuthenticated() && 
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.lecturerUid is string && resource.data.lecturerUid == request.auth.uid));
    }

    // Course join requests
    match /courseJoinRequests/{requestId} {
      function hasRequiredCreateFields() {
        return request.resource.data.keys().hasAll([
          'courseId',
          'courseName',
          'lecturerUid',
          'studentUid',
          'studentName',
          'studentEmail',
          'status',
          'createdAt',
          'updatedAt',
          'approvedAt',
          'rejectedAt',
          'reviewedByUid'
        ]);
      }

      function isStudentCreateValid() {
        return isAuthenticated() &&
          hasRequiredCreateFields() &&
          request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.lecturerUid != request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.approvedAt == null &&
          request.resource.data.rejectedAt == null &&
          request.resource.data.reviewedByUid == null;
      }

      function canReadRequest() {
        return isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.lecturerUid == request.auth.uid
        );
      }

      function immutableCoreFieldsUnchanged() {
        return request.resource.data.courseId == resource.data.courseId &&
          request.resource.data.courseName == resource.data.courseName &&
          request.resource.data.lecturerUid == resource.data.lecturerUid &&
          request.resource.data.studentUid == resource.data.studentUid &&
          request.resource.data.studentName == resource.data.studentName &&
          request.resource.data.studentEmail == resource.data.studentEmail &&
          request.resource.data.createdAt == resource.data.createdAt;
      }

      function isLecturerReviewTransitionAllowed() {
        return isAuthenticated() &&
          resource.data.lecturerUid == request.auth.uid &&
          resource.data.status == 'pending' &&
          immutableCoreFieldsUnchanged() &&
          request.resource.data.updatedAt != resource.data.updatedAt &&
          request.resource.data.reviewedByUid == request.auth.uid &&
          (
            (
              request.resource.data.status == 'approved' &&
              request.resource.data.approvedAt != null
            ) ||
            (
              request.resource.data.status == 'rejected' &&
              request.resource.data.rejectedAt != null
            )
          );
      }

      allow create: if isStudentCreateValid();
      allow read: if canReadRequest();
      allow update: if isLecturerReviewTransitionAllowed();
      allow delete: if false;
    }
    
    // Course files collection
    match /courseFiles/{fileId} {
      // Anyone authenticated can read course files
      allow read: if isAuthenticated();
      
      // Users can create files
      allow create: if isAuthenticated() && request.resource.data.uploadedBy == request.auth.uid;
      
      // Only file owner can update/delete
      allow update, delete: if isAuthenticated() && 
        (resource.data.uploadedBy == request.auth.uid ||
         request.resource.data.uploadedBy == request.auth.uid);
    }
    
    // Appeals collection
    match /appeals/{appealId} {
      // Users can read their own appeals, or if they're the user in the appeal
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || !resource.exists);
      
      // Users can create appeals for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Allow update/delete for authenticated users
      allow update, delete: if isAuthenticated();
    }
    
    // Study buddy preferences collection
    match /studyBuddyPreferences/{prefId} {
      // Users can read their own preferences
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || !resource.exists);
      
      // Users can create/update their own preferences
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Allow delete
      allow delete: if isAuthenticated();
    }
    
    // Practice sessions collection
    match /practiceSessions/{sessionId} {
      // Users can read their own sessions
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || !resource.exists);
      
      // Users can create their own sessions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can update their own sessions
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow delete
      allow delete: if isAuthenticated();
    }
    
    // Practice results collection
    match /practiceResults/{resultId} {
      // Users can read their own results
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || !resource.exists);
      
      // Users can create their own results
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can update their own results
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow delete
      allow delete: if isAuthenticated();
    }
    
    // Study Journal - Tasks collection
    match /studyTasks/{taskId} {
      // Users can read their own tasks
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || !resource.exists);
      
      // Users can create their own tasks
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can update their own tasks
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can delete their own tasks
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Tutor applications (student applies; admin reviews)
    match /tutorApplications/{applicationId} {
      function isAdminUser() {
        return isAuthenticated() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      allow read: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid ||
        isAdminUser()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.applicantUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.declarationAccepted == true &&
        request.resource.data.gradeSheetUrl is string &&
        request.resource.data.courseId is string &&
        request.resource.data.courseName is string;

      allow update: if isAdminUser();
      allow delete: if isAdminUser();
    }

    // Tutor-authored manual exercises (tutor tools; not AI practice)
    match /tutorExercises/{exerciseId} {
      function tutorExerciseCreateValid() {
        return isAuthenticated() &&
          request.resource.data.tutorUid is string &&
          request.resource.data.tutorUid == request.auth.uid &&
          request.resource.data.keys().hasAll([
            'courseId',
            'courseName',
            'tutorUid',
            'tutorName',
            'title',
            'instructions',
            'questionType',
            'questions',
            'status',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.courseId is string &&
          request.resource.data.courseName is string &&
          request.resource.data.tutorName is string &&
          request.resource.data.title is string &&
          request.resource.data.instructions is string &&
          request.resource.data.questionType in ['open_text', 'multiple_choice', 'true_false'] &&
          request.resource.data.questions is list &&
          request.resource.data.status in ['draft', 'published'];
      }

      function tutorExerciseCoreImmutable() {
        return request.resource.data.courseId == resource.data.courseId &&
          request.resource.data.courseName == resource.data.courseName &&
          request.resource.data.tutorName == resource.data.tutorName &&
          request.resource.data.createdAt == resource.data.createdAt;
      }

      function tutorExerciseStatusAllowed() {
        return (resource.data.status == 'draft' &&
            request.resource.data.status in ['draft', 'published']) ||
          (resource.data.status == 'published' && request.resource.data.status == 'published');
      }

      allow read: if isAuthenticated() && (
        resource.data.tutorUid == request.auth.uid ||
        resource.data.status == 'published'
      );
      allow create: if tutorExerciseCreateValid();
      allow update: if isAuthenticated() &&
        resource.data.tutorUid == request.auth.uid &&
        request.resource.data.tutorUid == resource.data.tutorUid &&
        tutorExerciseCoreImmutable() &&
        request.resource.data.questionType == resource.data.questionType &&
        request.resource.data.questionType in ['open_text', 'multiple_choice', 'true_false'] &&
        request.resource.data.title is string &&
        request.resource.data.instructions is string &&
        request.resource.data.questions is list &&
        tutorExerciseStatusAllowed() &&
        (request.resource.data.status != 'published' || request.resource.data.publishedAt != null);
      allow delete: if isAuthenticated() && resource.data.tutorUid == request.auth.uid;
    }

    // Student submissions for tutor exercises (one doc id per exercise + student enforced in app layer)
    match /tutorExerciseSubmissions/{submissionId} {
      function tutorExerciseSubmissionCreateValid() {
        return isAuthenticated() &&
          submissionId == request.resource.data.exerciseId + '_' + request.auth.uid &&
          request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.keys().hasAll([
            'id',
            'exerciseId',
            'courseId',
            'courseName',
            'tutorUid',
            'tutorName',
            'studentUid',
            'studentName',
            'answers',
            'status',
            'submittedAt',
            'updatedAt',
            'grade',
            'feedback',
            'gradedAt'
          ]) &&
          request.resource.data.id is string &&
          request.resource.data.id == submissionId &&
          request.resource.data.exerciseId is string &&
          request.resource.data.courseId is string &&
          request.resource.data.courseName is string &&
          request.resource.data.tutorUid is string &&
          request.resource.data.tutorName is string &&
          request.resource.data.studentUid is string &&
          request.resource.data.studentName is string &&
          request.resource.data.answers is list &&
          request.resource.data.status == 'submitted' &&
          request.resource.data.grade == null &&
          request.resource.data.feedback == null &&
          request.resource.data.gradedAt == null;
      }

      function tutorExerciseSubmissionTutorGradeUpdate() {
        return resource.data.tutorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'grade', 'feedback', 'gradedAt', 'updatedAt'
          ]) &&
          request.resource.data.exerciseId == resource.data.exerciseId &&
          request.resource.data.courseId == resource.data.courseId &&
          request.resource.data.courseName == resource.data.courseName &&
          request.resource.data.tutorUid == resource.data.tutorUid &&
          request.resource.data.tutorName == resource.data.tutorName &&
          request.resource.data.studentUid == resource.data.studentUid &&
          request.resource.data.studentName == resource.data.studentName &&
          request.resource.data.answers == resource.data.answers &&
          request.resource.data.submittedAt == resource.data.submittedAt &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.status == 'graded' &&
          (request.resource.data.grade is int || request.resource.data.grade is float) &&
          request.resource.data.grade >= 0 &&
          request.resource.data.grade <= 100 &&
          request.resource.data.feedback is string &&
          request.resource.data.gradedAt is timestamp &&
          request.resource.data.updatedAt is timestamp &&
          (!resource.data.keys().hasAll(['totalQuestions']) || request.resource.data.totalQuestions == resource.data.totalQuestions) &&
          (!resource.data.keys().hasAll(['questionType']) || request.resource.data.questionType == resource.data.questionType);
      }

      allow read: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid ||
        resource.data.tutorUid == request.auth.uid
      );
      allow create: if tutorExerciseSubmissionCreateValid();
      allow update: if isAuthenticated() && tutorExerciseSubmissionTutorGradeUpdate();
      allow delete: if false;
    }
    
    // Study Journal - Sessions collection
    match /studySessions/{sessionId} {
      // Users can read their own sessions
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || !resource.exists);
      
      // Users can create their own sessions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can update their own sessions
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can delete their own sessions
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Allow all other collections for authenticated users (for future features)
    match /{document=**} {
      allow read, write: if isAuthenticated() && !isProtectedPath();
    }
  }
}

